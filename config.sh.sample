#!/bin/sh
#
# $Id: config.sh.sample,v 1.11 2012-12-29 21:51:51 dan Exp $
#

LOGGER="/usr/bin/logger -p local3.info"

# this must always be defined and functional.
FRESHPORTS_FREEBSD_CVS_URL="https://www.freebsd.org/cgi/cvsweb.cgi"
FRESHPORTS_FREEBSD_SVN_URL="https://svn.freebsd.org"

FETCH="/usr/bin/fetch"
FETCH_OPTIONS="-qo"

# where is this website installed?
# do not include a trailing slash
# this directory should contain the www and scripts directories.
BASEDIR="/var/db/freshports"

#
# the directory where logs go.  used mainly for notifications
# and outputs of vuxml processing
#
DIRLOG="/var/log/freshports"

# what is the URL for this website?
# MUST have a trailing /
WEBSITEURL="http://WEBSITE_URL"

#
# where do I find files such as load_xml_into_db.pl
#
SCRIPTDIR="/usr/local/libexec/freshports"

#
# Where does the msg directory start?
# This directory should contain the files
# created by ${SCRIPTDIR}/procmail/create_dirs.sh
# and be the value which supplied to that script.
#
MSGDIR="${BASEDIR}/message-queues"

DYNAMICROOT="${BASEDIR}/cache"
CACHINGROOT="${DYNAMICROOT}"
HTMLROOT="${DYNAMICROOT}/html"

# used by cache-refresh.sh
CACHEDIR="${CACHINGROOT}"
NEWSCACHEDIR="${CACHINGROOT}/news"

# used by cache-refresh.sh & process_www_en_ports_categories.sh
SPOOLINGDIR="${CACHINGROOT}/spooling"

# What file do we set for /usr/ports/MOVED?

MOVEDFLAGFILE="${BASEDIR}/signals/refresh_moved"

# What file do we set for /usr/ports/UPDATING?

UPDATINGFLAGFILE="${BASEDIR}/signals/refresh_updating"

PORTSFREEZEFILE="${BASEDIR}/signals/PortsFreezeIsOn"

VUXMLFLAGFILE="${BASEDIR}/signals/vuxml"
VUXMLMUTEX="${BASEDIR}/signals/vuxml_mutex"
WWWENPORTSCATEGORIES="${BASEDIR}/signals/www.en.ports.categories"

CACHE_NEEDS_REFRESH="${BASEDIR}/signals/cache_needs_refresh"

# scripts for the jail
FRESHPORTS_JAIL_BASE_DIR="${BASEDIR}/ports-jail"
FRESHPORTS_JAIL_MASTER_PORT_SCRIPT="/make-master-port-test.sh"
FRESHPORTS_JAIL_USER="freshports"

#
# these are relative to FRESHPORTS_JAIL_BASE_DIR
#

# best without a trailing slash
PORTSDIRBASE="/var/db/repos"
# note: this works on HEAD only
# and is relative to ${FRESHPORTS_JAIL_BASE_DIR}
PORTSDIR="${PORTSDIRBASE}/PORTS-head"
ADMINEMAIL="dan@langille.org"

if [ -e 'OFFLINE' ]
then
	OFFLINE=1;
else
	OFFLINE=0;
fi

#
# we provide readonly access to shell scripts
# no updates are performed
#
PSQL=/usr/local/bin/psql
DB=freshports.org
HOST='localhost'
DBUSER='reading'
# password goes in ~/.pgpass

# used for psql connections to the database
# see https://www.postgresql.org/docs/12/libpq-envars.html
PGSSLMODE=verify-full

BASEDIR_PACKAGER="/var/db/freshports/packagesite"
